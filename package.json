{
  "name": "agriculture-inventory-server",
  "version": "1.0.0",
  "description": "Agriculture Inventory Management REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "ts-node src/infrastructure/database/init.ts",
    "db:seed": "ts-node src/infrastructure/database/seed.ts",
    "db:reset": "ts-node src/infrastructure/database/reset.ts",
    "db:reset:seed": "ts-node src/infrastructure/database/reset.ts && ts-node src/infrastructure/database/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
